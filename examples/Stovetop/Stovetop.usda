                interpolation = "faceVarying"
            )
            uniform token subdivisionScheme = "none"
        }

        def PhysicsRevoluteJoint "RevoluteJoint"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </root/Stovetop_Body001>
            rel physics:body1 = </root/Stovetop_Knob001>
            point3f physics:localPos0 = (0.09, 0.07, 0.055)
            point3f physics:localPos1 = (0.09, 0.07, 0.055)
            float physics:lowerLimit = -270
            float physics:upperLimit = 0
        }
    }

