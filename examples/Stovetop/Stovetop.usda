            point3f[] points = [(0.36, 0.04, 0.04), (0.42, 0.04, 0.04), (0.42, 0.1, 0.04), (0.36, 0.1, 0.04), (0.36, 0.04, 0.07), (0.42, 0.04, 0.07), (0.42, 0.1, 0.07), (0.36, 0.1, 0.07)]
